root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{java,kt,kts,groovy,xml}]
indent_size = 4

[*.{ts,tsx,js,jsx,html,scss,css,json,yaml,yml,dart,md}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
