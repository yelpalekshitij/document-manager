# Copy to .env and adjust as needed. Never commit .env.

# ---- Postgres ----
POSTGRES_USER=vaultdoc
POSTGRES_PASSWORD=vaultdoc_dev_pw
POSTGRES_DB=vaultdoc

# ---- Redis ----
REDIS_PASSWORD=vaultdoc_dev_pw

# ---- Elasticsearch ----
ES_JAVA_OPTS=-Xms512m -Xmx512m

# ---- MinIO ----
MINIO_ROOT_USER=vaultdoc
MINIO_ROOT_PASSWORD=vaultdoc_dev_pw
MINIO_BUCKET=vaultdoc-docs

# ---- Backend JWT signing (HS256 dev key — rotate in prod) ----
JWT_SECRET=dev-only-secret-do-not-use-in-production-please-rotate-me
